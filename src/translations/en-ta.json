    "ta": "மேம்பட்ட சென்சார்களைப் பயன்படுத்தி மண், வானிலை மற்றும் பயிர் ஆரோக்கியத்தை நேரடி நேரக் கண்காணிப்புக்கு உள்வாங்கவும்."
  },
  "automated_irrigation_systems": {
    "en": "Automated Irrigation Systems",
    "ta": "தானியங்கு நீர்ப்பாசன அமைப்புகள்"
  },
  "automated_irrigation_description": {
    "en": "Optimize water usage with smart, automated irrigation systems tailored to crop needs.",
    "ta": "பயிரின் தேவைகளுக்கேற்ப, ஸ்மார்ட், தானியங்கி நீர்ப்பாசன அமைப்புகள் மூலம் நீர் பயன்பாட்டை மேம்படுத்துங்கள்."
  },
  "drone_based_crop_monitoring": {
    "en": "Drone-Based Crop Monitoring",
    "ta": "ட்ரோன் அடிப்படையிலான பயிர் கண்காணிப்பு"
  },
  "drone_monitoring_description": {
    "en": "Utilize drones for aerial surveillance, precise mapping, and early detection of crop issues.",
    "ta": "பயிர் சிக்கல்களை வான்வழி கண்காணிப்பு, துல்லியமான கணிப்பு மற்றும் ஆரம்பகால கண்டறிதலுக்கு ட்ரோன்களைப் பயன்படுத்துங்கள்."
  },
  "ai_powered_analytics_platform": {
    "en": "AI-Powered Analytics Platform",
    "ta": "AI-இயங்கும் பகுப்பாய்வு தளம்"
  },
  "ai_analytics_description": {
    "en": "Gain actionable insights from your farm data with our powerful AI-driven analytics platform.",
    "ta": "உங்கள் பண்ணைத் தரவுகளிலிருந்து செயல்படக்கூடிய நுண்ணறிவுகளை, எங்கள் சக்திவாய்ந்த AI-இயக்கப்பட்ட பகுப்பாய்வு மேடையின் மூலம் பெறுங்கள்."
  },
  "supply_chain_solutions": {
    "en": "Supply Chain Solutions",
    "ta": "விநியோக சங்கிலி தீர்வுகள்"
  },
  "supply_chain_description": {
    "en": "Streamline your agricultural supply chain for better efficiency and reduced waste.",
    "ta": "மேம்பட்ட திறமை மற்றும் குறைக்கப்பட்ட கழிவுகளுக்காக உங்கள் விவசாய சப்ளை செயினைத் திறம்பட ஒழுங்கமைக்கவும்."
  },
  "market_linkage_platform": {
    "en": "Market Linkage Platform",
    "ta": "சந்தை இணைப்பு தளம்"
  },
  "market_linkage_description": {
    "en": "Connect directly with buyers and markets to ensure fair prices and timely sales for your produce.",
    "ta": "நேரடியாக வாங்குபவர்கள் மற்றும் சந்தைகளுடன் இணைக்கவும், உங்கள் உற்பத்திப் பொருட்களுக்கு நியாயமான விலை மற்றும் சரியான நேரத்தில் விற்பனையை உறுதி செய்ய."
  },
  "advantages_of_sensors": {
    "en": "Advantages of Sensors",
    "ta": "சென்சார்களின் நன்மைகள்"
  },
  "increased_efficiency": {
    "en": "Increased Efficiency",
    "ta": "அதிகரித்த செயல்திறன்"
  },
  "increased_efficiency_description": {
    "en": "Automate routine tasks and optimize resource allocation to boost overall farm efficiency.",
    "ta": "வழக்கமான பணிகளை தானியங்கமாக்கி, வள ஒதுக்கீட்டை மேம்படுத்தி, மொத்த பண்ணைத் திறனை அதிகரிக்கவும்."
  },
  "improved_yields": {
    "en": "Improved Yields",
    "ta": "மேம்படுத்தப்பட்ட விளைச்சல்"
  },
  "improved_yields_description": {
    "en": "Make data-driven decisions to enhance crop growth and maximize your harvest.",
    "ta": "தரவு-சார்ந்த முடிவுகளை எடுத்து, பயிர் வளர்ச்சியை மேம்படுத்தி உங்கள் அறுவடையை அதிகரிக்கவும்."
  },
  "early_problem_detection": {
    "en": "Early Problem Detection",
    "ta": "ஆரம்பகால சிக்கல் கண்டறிதல்"
  },
  "early_problem_detection_description": {
    "en": "Identify potential issues like pests, diseases, or nutrient deficiencies before they escalate.",
    "ta": "பூச்சிகள், நோய்கள் அல்லது ஊட்டச்சத்து குறைபாடுகள் போன்ற சாத்தியமான சிக்கல்கள் அதிகரிப்பதற்கு முன்பே அவற்றை கண்டறியவும்."
  },
  "reduced_labor_costs": {
    "en": "Reduced Labor Costs",
    "ta": "குறைக்கப்பட்ட தொழிலாளர் செலவுகள்"
  },
  "reduced_labor_costs_description": {
    "en": "Minimize manual labor requirements through automation and smart farming techniques.",
    "ta": "தானியங்கு மற்றும் ஸ்மார்ட் விவசாய நுட்பங்கள் மூலம் கைத்தொழில் உழைப்பு தேவைகளைக் குறைக்கவும்."
  },
  "environmental_sustainability": {
    "en": "Environmental Sustainability",
    "ta": "சுற்றுச்சூழல் நிலைத்தன்மை"
  },
  "environmental_sustainability_description": {
    "en": "Adopt eco-friendly practices by optimizing resource use and reducing environmental impact.",
    "ta": "வளங்களின் பயன்பாட்டை மேம்படுத்தி, சுற்றுச்சூழல் தாக்கத்தைக் குறைப்பதன் மூலம் சூழல் நட்பு நடைமுறைகளை ஏற்கவும்."
  },
  "future_scope": {
    "en": "Future scope",
    "ta": "எதிர்கால பரிமாணம்"
  },
  "iot_in_home_land_farming": {
    "en": "IoT in Home Land Farming",
    "ta": "வீட்டு நில விவசாயத்தில் IoT"
  },
  "Future scope": {
    "en": "Future scope",
    "ta": "எதிர்கால பரிமாணம்"
  },
  "smart_gardens_home": {
    "en": "Smart Gardens (Home)",
    "ta": "ஸ்மார்ட் தோட்டங்கள் (வீடு)"
  },
  "smart_gardens_description": {
    "en": "Transform home gardens into smart, self-sustaining ecosystems with automated care.",
    "ta": "தானியங்குப் பராமரிப்புடன் வீட்டுத் தோட்டங்களை ஸ்மார்ட், சுய தாங்கல் சுற்றுச்சூழல் அமைப்புகளாக மாற்றுங்கள்."
  },
  "livestock_monitoring": {
    "en": "Livestock Monitoring",
    "ta": "கால்நடை கண்காணிப்பு"
  },
  "livestock_monitoring_description": {
    "en": "Keep track of livestock health, location, and behavior with intelligent monitoring systems.",
    "ta": "அறிவார்ந்த கண்காணிப்பு அமைப்புகள் மூலம் கால்நடைகளின் ஆரோக்கியம், இருப்பிடம் மற்றும் நடத்தையைக் கண்காணிக்கவும்."
  },
  "greenhouse_automation": {
    "en": "Greenhouse Automation",
    "ta": "பசுமைக்குடில் ஆட்டோமேஷன்"
  },
  "greenhouse_automation_description": {
    "en": "Automate climate control, irrigation, and lighting in greenhouses for optimal growing conditions.",
    "ta": "பசுமை இல்லங்களில் காலநிலை கட்டுப்பாடு, நீர்ப்பாசனம் மற்றும் விளக்குகளை தானியங்கியாக்கி, உகமமான வளர்ச்சி நிலைமைகளை உருவாக்குங்கள்."
  },
  "pest_disease_management": {
    "en": "Pest & Disease Management",
    "ta": "பூச்சி மற்றும் நோய் மேலாண்மை"
  },
  "pest_disease_management_description": {
    "en": "Implement proactive strategies for identifying and managing pests and diseases effectively.",
    "ta": "பூச்சிகள் மற்றும் நோய்களைத் திறம்பட அடையாளம் காணவும் மேலாண்மை செய்யவும் முன்னெச்சரிக்கை மூலோபாயங்களை செயல்படுத்துங்கள்."
  },
  "weather_monitoring_prediction": {
    "en": "Weather Monitoring & Prediction",
    "ta": "வானிலை கண்காணிப்பு & கணிப்பு"
  },
  "weather_monitoring_description": {
    "en": "Access real-time weather data and forecasts to plan farming activities and mitigate risks.",
    "ta": "நேரடி காலநிலைத் தரவு மற்றும் வானிலை முன்னறிவிப்புகளை அணுகி, விவசாய நடவடிக்கைகளைத் திட்டமிட்டு, அபாயங்களைக் குறைக்கவும்."
  },
  "asset_equipment_tracking": {
    "en": "Asset & Equipment Tracking",
    "ta": "சொத்து மற்றும் உபகரண கண்காணிப்பு"
  },
  "asset_equipment_description": {
    "en": "Monitor and track your farm assets and equipment for better utilization and security.",
    "ta": "உங்கள் பண்ணைச் சொத்துகள் மற்றும் உபகரணங்களை சிறந்த பயன்பாடு மற்றும் பாதுகாப்பிற்காக கண்காணித்து கண்காணிக்கவும்."
  },
